        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam packageStyle rectangle\n\nactor \&quot;Độc giả\&quot; as Reader\nactor \&quot;Thủ thư\&quot; as Librarian\nactor \&quot;Hệ thống Mail / Timer\&quot; as SystemTimer\n\nLibrarian --|&gt; Reader : Kế thừa\n\nrectangle \&quot;Hệ thống Thư viện Trực tuyến\&quot; {\n  \n  package \&quot;Tra cứu &amp; Sử dụng tài liệu\&quot; {\n    usecase \&quot;Tìm kiếm tài liệu\&quot; as UC_TimKiem\n    usecase \&quot;Đọc tài liệu điện tử\&quot; as UC_DocTrucTuyen\n    usecase \&quot;Tải tài liệu điện tử\&quot; as UC_TaiTaiLieu\n    usecase \&quot;Đăng ký mượn sách\&quot; as UC_DangKyMuon\n  }\n\n  package \&quot;Đặt mua &amp; Tài khoản\&quot; {\n    usecase \&quot;Đăng nhập / Đăng ký\&quot; as UC_DangNhap\n    usecase \&quot;Yêu cầu đặt mua tài liệu\&quot; as UC_DatMua\n  }\n\n  package \&quot;Nghiệp vụ Thủ thư\&quot; {\n    usecase \&quot;Quản lý mượn - trả\&quot; as UC_QuanLyMuonTra\n    usecase \&quot;Xem tình trạng mượn / quá hạn\&quot; as UC_XemTinhTrang\n    usecase \&quot;Cập nhật danh mục sách\&quot; as UC_CapNhatDanhMuc\n    usecase \&quot;Duyệt yêu cầu đặt mua\&quot; as UC_DuyetDatMua\n  }\n\n  package \&quot;Tự động hóa\&quot; {\n    usecase \&quot;Gửi email nhắc hạn (trước 3 ngày)\&quot; as UC_GuiMailNhacHan\n  }\n}\n\n&#39; Quan hệ của Độc giả\nReader --&gt; UC_TimKiem\nReader --&gt; UC_DocTrucTuyen\nReader --&gt; UC_TaiTaiLieu\nReader --&gt; UC_DangKyMuon\nReader --&gt; UC_DatMua\n\n&#39; Quan hệ phụ thuộc (Include / Extend)\nUC_DatMua .&gt; UC_DangNhap : &lt;&lt;include&gt;&gt;\n\n&#39; Quan hệ của Thủ thư\nLibrarian --&gt; UC_QuanLyMuonTra\nLibrarian --&gt; UC_XemTinhTrang\nLibrarian --&gt; UC_CapNhatDanhMuc\nLibrarian --&gt; UC_DuyetDatMua\n\n&#39; Quan hệ của Hệ thống Mail\nSystemTimer --&gt; UC_GuiMailNhacHan\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="TxlkHw2CZ29x_v9TCD4S-1">
