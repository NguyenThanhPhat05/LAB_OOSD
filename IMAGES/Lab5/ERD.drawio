        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam linetype ortho\nskinparam backgroundColor #FFFFFF\nskinparam ClassBackgroundColor #FFFDD0\nskinparam ClassBorderColor #8B0000\nskinparam ArrowColor #8B0000\n\nentity \&quot;PhuongTien\&quot; as PhuongTien {\n  * MaPT : varchar(20) [PK]\n  --\n  TenPT : varchar(50)\n}\n\nentity \&quot;DiaDiem\&quot; as DiaDiem {\n  * MaDiaDiem : varchar(20) [PK]\n  --\n  TenDiaDiem : varchar(100)\n}\n\nentity \&quot;DungChan\&quot; as DungChan {\n  * MaDungChan : varchar(20) [PK]\n  # MaTour : varchar(20) [FK]\n  # MaDiaDiem : varchar(20) [FK]\n  # MaPT : varchar(20) [FK]\n  --\n  ThuTu : int\n  DoiPhuongTien : int\n  CoNoiAn : int\n  CoKhachSan : int\n  LoaiKhachSan : int\n}\n\nentity \&quot;Tour\&quot; as Tour {\n  * MaTour : varchar(20) [PK]\n  --\n  TenTour : nvarchar(100)\n  SoNgay : int\n  SoDem : int\n  DonGia : decimal(18,2)\n}\n\nentity \&quot;ChiTietTourDiemTQ\&quot; as ChiTietTourDiemTQ {\n  * MaTour : varchar(20) [PK, FK]\n  * MaDiemTQ : varchar(20) [PK, FK]\n}\n\nentity \&quot;DiemThamQuan\&quot; as DiemThamQuan {\n  * MaDiemTQ : varchar(20) [PK]\n  --\n  TenDiemTQ : nvarchar(100)\n  DiaDiem : nvarchar(100)\n  NoiDung : nvarchar(300)\n  YNghia : nvarchar(500)\n}\n\nentity \&quot;ChuyenTour\&quot; as ChuyenTour {\n  * MaChuyen : varchar(20) [PK]\n  # MaTour : varchar(20) [FK]\n  --\n  NgayDi : date\n  NgayVe : date\n  SoChoToiDa : int\n}\n\nentity \&quot;ThanhVienDoan\&quot; as ThanhVienDoan {\n  * MaTV : varchar(20) [PK]\n  # SoPhieu : varchar(30) [FK]\n  --\n  HoTen : nvarchar(100)\n  NgaySinh : date\n  SoCMND : varchar(20)\n}\n\nentity \&quot;PhieuDangKyDoan\&quot; as PhieuDangKyDoan {\n  * SoPhieu : varchar(30) [PK, FK]\n  # MaTour : varchar(20) [FK]\n  --\n  NgayDi : date\n  SoNguoi : int\n  DiaChiDon : nvarchar(200)\n  CoBaoHiem : bit\n  TienDatCoc : decimal(18,2)\n}\n\nentity \&quot;PhieuDangKy\&quot; as PhieuDangKy {\n  * SoPhieu : varchar(30) [PK]\n  # MaKH : varchar(20) [FK]\n  --\n  LoaiPhieu : varchar(20)\n  NgayLap : datetime\n  TongTien : decimal(18,2)\n  TrangThai : nvarchar(50)\n}\n\nentity \&quot;PhieuDangKyChuyen\&quot; as PhieuDangKyChuyen {\n  * SoPhieu : varchar(30) [PK, FK]\n  # MaChuyen : varchar(20) [FK]\n  # MaDiemBan : varchar(20) [FK]\n  # MaDiemDon : varchar(20) [FK]\n  --\n  SoVe : int\n}\n\nentity \&quot;DiemBanVe\&quot; as DiemBanVe {\n  * MaDiemBan : varchar(20) [PK]\n  --\n  TenDiemBan : nvarchar(100)\n  DiaChi : nvarchar(200)\n  DienThoai : varchar(15)\n}\n\nentity \&quot;DiemDon\&quot; as DiemDon {\n  * MaDiemDon : varchar(20) [PK]\n  --\n  TenDiemDon : nvarchar(100)\n  DiaChi : nvarchar(200)\n}\n\nentity \&quot;ThanhToan\&quot; as ThanhToan {\n  * MaThanhToan : varchar(20) [PK]\n  # SoPhieu : varchar(30) [FK]\n  --\n  NgayThanhToan : datetime\n  LoaiThanhToan : varchar(30)\n  HinhThuc : varchar(30)\n  SoTien : decimal(18,2)\n}\n\nentity \&quot;KhachHang\&quot; as KhachHang {\n  * MaKH : varchar(20) [PK]\n  --\n  TenKH : nvarchar(100)\n  DiaChi : nvarchar(200)\n  DienThoai : varchar(15)\n  LoaiKhach : varchar(10)\n  NguoiDaiDien : nvarchar(100)\n  SoCMND : varchar(20)\n}\n\nentity \&quot;PhieuKhaoSat\&quot; as PhieuKhaoSat {\n  * MaKS : varchar(20) [PK]\n  # SoPhieu : varchar(30) [FK]\n  --\n  NgayGui : date\n  NgayTraLoi : date\n  DiemDanhGia : int\n  GopY : nvarchar(300)\n}\n\nentity \&quot;NhanVien\&quot; as NhanVien {\n  * MaNV : varchar(20) [PK]\n  --\n  HoTen : nvarchar(100)\n  DiaChi : nvarchar(200)\n  DienThoai : varchar(15)\n  LuongCanBan : decimal(18,2)\n}\n\nentity \&quot;PhanCong\&quot; as PhanCong {\n  * MaPC : varchar(20) [PK]\n  # MaNV : varchar(20) [FK]\n  # MaChuyen : varchar(20) [FK]\n  # SoPhieu : varchar(30) [FK]\n  --\n  NgayBatDau : date\n  NgayKetThuc : date\n  TienCongTour : decimal(18,2)\n}\n\n&#39; Định nghĩa mối quan hệ theo lược đồ[cite: 5]\nPhuongTien ||--o{ DungChan\nDiaDiem ||--o{ DungChan\nTour ||--o{ DungChan\nTour ||--o{ ChiTietTourDiemTQ\nDiemThamQuan ||--o{ ChiTietTourDiemTQ\nTour ||--o{ ChuyenTour\nTour ||--o{ PhieuDangKyDoan\nKhachHang ||--o{ PhieuDangKy\nPhieuDangKy ||--|{ PhieuDangKyDoan\nPhieuDangKy ||--|{ PhieuDangKyChuyen\nPhieuDangKyDoan ||--o{ ThanhVienDoan\nChuyenTour ||--o{ PhieuDangKyChuyen\nDiemBanVe ||--o{ PhieuDangKyChuyen\nDiemDon ||--o{ PhieuDangKyChuyen\nPhieuDangKy ||--o{ ThanhToan\nPhieuDangKy ||--o{ PhieuKhaoSat\nNhanVien ||--o{ PhanCong\nChuyenTour ||--o{ PhanCong\nPhieuDangKyDoan ||--o{ PhanCong\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="EzRNL6KI-fqMMfQgICtc-328">
