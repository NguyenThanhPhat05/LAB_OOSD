        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\nskinparam backgroundColor #FFFFFF\nskinparam ArrowColor #8B0000\nskinparam ClassBackgroundColor #FFFDD0\nskinparam ClassBorderColor #8B0000\n\nclass Tour {\n  + MaTour : String\n  + TenTour : String\n  + SoNgay : Integer\n  + SoDem : Integer\n  + DonGia : Decimal\n}\n\nclass DungChan {\n  + MaDungChan : String\n  + ThuTu : Integer\n  + DoiPhuongTien : Boolean\n  + CoNoiAn : Boolean\n  + CoKhachSan : Boolean\n  + LoaiKhachSan : Integer\n}\n\nclass PhuongTien {\n  + MaPT : String\n  + TenPT : String\n}\n\nclass DiaDiem {\n  + MaDiaDiem : String\n  + TenDiaDiem : String\n}\n\nclass DiemThamQuan {\n  + MaDiemTQ : String\n  + TenDiemTQ : String\n  + DiaDiem : String\n  + NoiDung : String\n  + YNghia : String\n}\n\nclass ChuyenTour {\n  + MaChuyen : String\n  + NgayDi : Date\n  + NgayVe : Date\n  + SoChoToiDa : Integer\n}\n\nclass KhachHang {\n  + MaKH : String\n  + TenKH : String\n  + DiaChi : String\n  + DienThoai : String\n}\n\nclass KhachLe {\n  + SoCMND : String\n}\n\nclass KhachDoan {\n  + NguoiDaiDien : String\n}\n\nclass PhieuDangKy {\n  + SoPhieu : String\n  + NgayLap : DateTime\n  + TongTien : Decimal\n  + TrangThai : String\n}\n\nclass PhieuDangKyDoan {\n  + NgayDi : Date\n  + SoNguoi : Integer\n  + DiaChiDon : String\n  + CoBaoHiem : Boolean\n  + TienDatCoc : Decimal\n}\n\nclass PhieuDangKyChuyen {\n  + SoVe : Integer\n}\n\nclass ThanhVienDoan {\n  + MaTV : String\n  + HoTen : String\n  + NgaySinh : Date\n  + SoCMND : String\n}\n\nclass DiemBanVe {\n  + MaDiemBan : String\n  + TenDiemBan : String\n  + DiaChi : String\n  + DienThoai : String\n}\n\nclass DiemDon {\n  + MaDiemDon : String\n  + TenDiemDon : String\n  + Diachi : String\n}\n\nclass NhanVien {\n  + MaNV : String\n  + HoTen : String\n  + Diachi : String\n  + DienThoai : String\n  + LuongCanBan : Decimal\n}\n\nclass PhanCong {\n  + MaPC : String\n  + NgayBatDau : Date\n  + NgayKetThuc : Date\n  + TienCongTour : Decimal\n}\n\nclass ThanhToan {\n  + MaThanhToan : String\n  + NgayThanhToan : DateTime\n  + LoaiThanhToan : String\n  + HinhThuc : String\n  + SoTien : Decimal\n}\n\nclass PhieuKhaoSat {\n  + MaKS : String\n  + NgayGui : Date\n  + NgayTraLoi : Date\n  + DiemDanhGia : Integer\n  + GopY : String\n}\n\n&#39; Quan hệ kế thừa (Generalization)\nKhachLe --|&gt; KhachHang\nKhachDoan --|&gt; KhachHang\nPhieuDangKyDoan --|&gt; PhieuDangKy\nPhieuDangKyChuyen --|&gt; PhieuDangKy\n\n&#39; Quan hệ kết hợp và bản số (Associations &amp; Multiplicity)\nTour \&quot;1\&quot; --&gt; \&quot;1..*\&quot; DungChan\nDungChan \&quot;1\&quot; --&gt; \&quot;1\&quot; PhuongTien\nDungChan \&quot;1\&quot; --&gt; \&quot;1\&quot; DiaDiem\nTour \&quot;1\&quot; --&gt; \&quot;1..*\&quot; DiemThamQuan\nTour \&quot;1\&quot; --&gt; \&quot;0..*\&quot; ChuyenTour\nTour \&quot;1\&quot; --&gt; \&quot;0..*\&quot; PhieuDangKyDoan\n\nKhachHang \&quot;1\&quot; --&gt; \&quot;0..*\&quot; PhieuDangKy\nPhieuDangKyDoan \&quot;1\&quot; --&gt; \&quot;0..*\&quot; ThanhVienDoan\n\nChuyenTour \&quot;1\&quot; --&gt; \&quot;0..*\&quot; PhieuDangKyChuyen\nDiemBanVe \&quot;1\&quot; --&gt; \&quot;0..*\&quot; PhieuDangKyChuyen\nDiemDon \&quot;1\&quot; --&gt; \&quot;0..*\&quot; PhieuDangKyChuyen\n\nPhieuDangKy \&quot;1\&quot; --&gt; \&quot;0..*\&quot; ThanhToan\nPhieuDangKy \&quot;1\&quot; --&gt; \&quot;0..1\&quot; PhieuKhaoSat\n\nNhanVien \&quot;1\&quot; --&gt; \&quot;0..*\&quot; PhanCong\nPhanCong \&quot;0..*\&quot; --&gt; \&quot;0..1\&quot; PhieuDangKyDoan : {xor}\nPhanCong \&quot;0..*\&quot; --&gt; \&quot;0..1\&quot; ChuyenTour : {xor}\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="EzRNL6KI-fqMMfQgICtc-78">
