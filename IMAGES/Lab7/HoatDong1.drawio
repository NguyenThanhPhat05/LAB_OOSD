        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam linetype ortho\nskinparam ActivityBackgroundColor #FEFECE\nskinparam ActivityBorderColor #A80036\n\nstart\n\n:Nhập thông tin ứng viên trúng tuyển\\n(họ tên, CCCD, phòng ban, vị trí);\n\n:Lập QĐ tuyển dụng\\n(thời gian, lương thử việc, điều khoản);\n\nif (Thiếu thông tin /\\nthời gian &lt;= 0?) then (có)\n  :Hủy giao dịch (rollback),\\nthông báo nguyên nhân;\n  -&gt; Nhập lại;\n  :Nhập thông tin ứng viên trúng tuyển\\n(họ tên, CCCD, phòng ban, vị trí);\n  :Lập QĐ tuyển dụng\\n(thời gian, lương thử việc, điều khoản);\nelse (hợp lệ)\nendif\n\n:Giám đốc xem xét,\\nký duyệt QĐ tuyển dụng;\n\nif (Giám đốc duyệt?) then (không)\n  :Hủy giao dịch (rollback),\\nthông báo nguyên nhân;\n  -&gt; Nhập lại;\n  :Nhập thông tin ứng viên trúng tuyển\\n(họ tên, CCCD, phòng ban, vị trí);\n  :Lập QĐ tuyển dụng\\n(thời gian, lương thử việc, điều khoản);\n  :Giám đốc xem xét,\\nký duyệt QĐ tuyển dụng;\nelse (có)\nendif\n\n:Lưu QĐ, ghi nhận nhân sự\\nvào phòng ban (Thử việc);\n\nnote right\n  Lập QĐ, lưu hồ sơ và cập nhật\n  phòng ban trong 1 transaction\nend note\n\n:Theo dõi, đánh giá\\ntrong thời gian thử việc;\n\nif (Đánh giá đạt?) then (không)\n  :Chấm dứt thử việc,\\ncập nhật trạng thái NV;\n  stop\nelse (đạt)\nendif\n\n:Ký HĐ lao động chính thức\\nkhi hết thời gian thử việc;\n\nif (Loại hợp đồng?) then (dài hạn)\n  :Lập hồ sơ BHYT, BHXH\\n(trích trừ từ lương);\nelse (ngắn hạn)\nendif\n\n:Lập QĐ chức vụ &amp;\\nphụ cấp chức vụ (nếu có);\n\n:Lập QĐ lương:\\nlương cơ bản, phụ cấp (nếu có);\n\nnote right\n  Tăng lương, bổ nhiệm sau này\n  ghi nhận bằng QĐ mới\nend note\n\n:Lưu hồ sơ nhân sự,\\nthông báo ký HĐ thành công;\n\nstop\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="EzRNL6KI-fqMMfQgICtc-3839">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
