        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\nskinparam linetype ortho\nskinparam BackgroundColor white\nhide circle\n\nentity \&quot;ChucVu\&quot; as ChucVu {\n  * **MaCV** : varchar(20) [PK]\n  --\n  TenCV : nvarchar(100)\n}\n\nentity \&quot;PhongBan\&quot; as PhongBan {\n  * **MaPB** : varchar(20) [PK]\n  --\n  TenPB : nvarchar(100)\n  MaTP : varchar(20)\n}\n\nentity \&quot;NhanVien\&quot; as NhanVien {\n  * **MaNV** : varchar(20) [PK]\n  --\n  HoTen : nvarchar(100)\n  NgaySinh : date\n  GioiTinh : nvarchar(10)\n  SoCCCD : varchar(20)\n  MaPB : varchar(20) [FK]\n  SoDienThoai : varchar(15)\n  DiaChi : nvarchar(200)\n  TrangThai : nvarchar(50)\n}\n\nentity \&quot;QuyetDinhTuyenDung\&quot; as QuyetDinhTuyenDung {\n  * **SoQDTD** : varchar(20) [PK]\n  --\n  MaNV : varchar(20) [FK]\n  MaPB : varchar(20) [FK]\n  NguoiKy : varchar(20)\n  NgayBDThuViec : date\n  NgayKTThuViec : date\n  LuongThuViec : decimal(18,2)\n  DieuKhoan : nvarchar(max)\n}\n\nentity \&quot;HopDong\&quot; as HopDong {\n  * **SoHD** : varchar(20) [PK]\n  --\n  MaNV : varchar(20) [FK]\n  LoaiHD : nvarchar(50)\n  NgayBD : date\n  NgayKy : date\n  NgayKetThuc : date\n}\n\nentity \&quot;HoSoBaoHiem\&quot; as HoSoBaoHiem {\n  * **MaBH** : varchar(20) [PK]\n  --\n  SoHD : varchar(20) [FK]\n  SoSoBHXH : varchar(20)\n  MaDongBHYT : varchar(20)\n  MucDongBHXH : decimal(18,2)\n  MucDongBHYT : decimal(18,2)\n  NgayLap : date\n}\n\nentity \&quot;QuyetDinhChucVu\&quot; as QuyetDinhChucVu {\n  * **SoQDCV** : varchar(20) [PK]\n  --\n  MaNV : varchar(20) [FK]\n  MaCV : varchar(20) [FK]\n  NgayHieuLuc : date\n  PhuCapChucVu : decimal(18,2)\n}\n\nentity \&quot;QuyetDinhLuong\&quot; as QuyetDinhLuong {\n  * **SoQDL** : varchar(20) [PK]\n  --\n  MaNV : varchar(20) [FK]\n  NgayHieuLuc : date\n  LuongCoBan : decimal(18,2)\n  PhuCapLuong : decimal(18,2)\n  PhuCapDocHai : decimal(18,2)\n  LyDo : nvarchar(250)\n}\n\nentity \&quot;KeHoachPhanCong\&quot; as KeHoachPhanCong {\n  * **MaKH** : varchar(20) [PK]\n  --\n  MaPB : varchar(20) [FK]\n  TuNgay : date\n  DenNgay : date\n}\n\nentity \&quot;ChiTietPhanCong\&quot; as ChiTietPhanCong {\n  * **MaKH** : varchar(20) [PK, FK]\n  * **MaNV** : varchar(20) [PK, FK]\n  --\n  NgayLam : date\n  CaLamViec : nvarchar(50)\n  CoPhuTroi : bit\n}\n\nentity \&quot;BangChamCong\&quot; as BangChamCong {\n  * **SoBCC** : varchar(20) [PK]\n  --\n  Thang : int\n  Nam : int\n  NgayLap : date\n}\n\nentity \&quot;ChiTietChamCong\&quot; as ChiTietChamCong {\n  * **SoBCC** : varchar(20) [PK, FK]\n  * **MaNV** : varchar(20) [PK, FK]\n  --\n  SoNgayCong : decimal(4,2)\n  SoNgayNghi : decimal(4,2)\n}\n\nentity \&quot;PhieuPhuTroi\&quot; as PhieuPhuTroi {\n  * **SoPhieuPT** : varchar(20) [PK]\n  --\n  NgayPhuTroi : date\n  HinhThuc : nvarchar(50)\n  HeSo : decimal(3,2)\n}\n\nentity \&quot;ChiTietPhieuPhuTroi\&quot; as ChiTietPhieuPhuTroi {\n  * **SoPhieuPT** : varchar(20) [PK, FK]\n  * **MaNV** : varchar(20) [PK, FK]\n  --\n  SoGio : decimal(4,2)\n}\n\nentity \&quot;BangLuong\&quot; as BangLuong {\n  * **SoBL** : varchar(20) [PK]\n  --\n  Thang : int\n  Nam : int\n  NgayLap : date\n  TrangThai : nvarchar(50)\n}\n\nentity \&quot;ChiTietBangLuong\&quot; as ChiTietBangLuong {\n  * **SoBL** : varchar(20) [PK, FK]\n  * **MaNV** : varchar(20) [PK, FK]\n  --\n  LuongCoBan : decimal(18,2)\n  PhuCap : decimal(18,2)\n  BaoHiemTru : decimal(18,2)\n  KhenThuong : decimal(18,2)\n  TienPhat : decimal(18,2)\n  BaoLanh : decimal(18,2)\n}\n\nentity \&quot;QuyetDinhKhenThuong\&quot; as QuyetDinhKhenThuong {\n  * **SoQDKT** : varchar(20) [PK]\n  --\n  NgayKy : date\n  LyDo : nvarchar(250)\n  HinhThuc : nvarchar(100)\n  DoiTuong : nvarchar(50)\n  MaNV : varchar(20) [FK]\n  MaPB : varchar(20) [FK]\n  SoTien : decimal(18,2)\n}\n\nentity \&quot;PhieuChiKhenThuong\&quot; as PhieuChiKhenThuong {\n  * **SoPhieuChi** : varchar(20) [PK]\n  --\n  SoQDKT : varchar(20) [FK]\n  NgayChi : date\n  SoTien : decimal(18,2)\n}\n\nentity \&quot;QuyetDinhKyLuat\&quot; as QuyetDinhKyLuat {\n  * **SoQDKL** : varchar(20) [PK]\n  --\n  NgayKy : date\n  LyDo : nvarchar(250)\n  HinhThuc : nvarchar(100)\n  DoiTuong : nvarchar(50)\n  MaNV : varchar(20) [FK]\n  MaPB : varchar(20) [FK]\n  SoTienPhat : decimal(18,2)\n}\n\nentity \&quot;PhieuThuNopPhat\&quot; as PhieuThuNopPhat {\n  * **SoPhieuThu** : varchar(20) [PK]\n  --\n  SoQDKL : varchar(20) [FK]\n  NgayThu : date\n  SoTien : decimal(18,2)\n  CachThu : nvarchar(50)\n}\n\n&#39; Thiết lập liên kết quan hệ chuẩn ERD\nPhongBan \&quot;1\&quot; -- \&quot;0..*\&quot; NhanVien\nPhongBan \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhTuyenDung\nPhongBan \&quot;1\&quot; -- \&quot;0..*\&quot; KeHoachPhanCong\nPhongBan \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhKhenThuong\nPhongBan \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhKyLuat\n\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhTuyenDung\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; HopDong\nHopDong \&quot;1\&quot; -- \&quot;0..1\&quot; HoSoBaoHiem\n\nChucVu \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhChucVu\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhChucVu\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhLuong\n\nKeHoachPhanCong \&quot;1\&quot; -- \&quot;1..*\&quot; ChiTietPhanCong\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietPhanCong\n\nBangChamCong \&quot;1\&quot; -- \&quot;1..*\&quot; ChiTietChamCong\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietChamCong\n\nPhieuPhuTroi \&quot;1\&quot; -- \&quot;1..*\&quot; ChiTietPhieuPhuTroi\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietPhieuPhuTroi\n\nBangLuong \&quot;1\&quot; -- \&quot;1..*\&quot; ChiTietBangLuong\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietBangLuong\n\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhKhenThuong\nQuyetDinhKhenThuong \&quot;1\&quot; -- \&quot;0..1\&quot; PhieuChiKhenThuong\n\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhKyLuat\nQuyetDinhKyLuat \&quot;1\&quot; -- \&quot;0..1\&quot; PhieuThuNopPhat\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="EzRNL6KI-fqMMfQgICtc-4007">
