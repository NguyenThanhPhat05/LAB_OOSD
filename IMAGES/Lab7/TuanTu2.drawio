        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nautonumber\nskinparam BoxPadding 10\nskinparam ParticipantPadding 10\n\nactor \&quot;NV nhân sự\&quot; as NV\nboundary \&quot;:FrmHopDong\&quot; as Frm\ncontrol \&quot;:HopDongService\&quot; as Service\nentity \&quot;:QuyetDinhTuyenDung\&quot; as EntQDTD\nentity \&quot;:HopDong\&quot; as EntHD\nentity \&quot;:QuyetDinhChucVu\&quot; as EntQDCV\nentity \&quot;:QuyetDinhLuong\&quot; as EntQDL\nentity \&quot;:HoSoBaoHiem\&quot; as EntHSBH\n\nNV -&gt; Frm : Chọn nhân viên hết thời gian thử việc\nFrm -&gt; Service : LayThongTinThuViec(maNV)\n\nService -&gt; EntQDTD : layQDTDThucViec(maNV)\nEntQDTD --&gt; Service : ngayKyThuViec, luongThuViec\nService --&gt; Frm : thông tin thử việc\nFrm --&gt; NV : Hiển thị thông tin thử việc\n\nNV -&gt; Frm : Nhập loại HĐ (dài hạn / ngắn hạn), ngày hiệu lực\nNV -&gt; Frm : Nhập sốQĐ CV, phụ cấp, lương cơ bản, phụ cấp lương\nNV -&gt; Frm : Nhấn \&quot;Ký hợp đồng\&quot;\n\nFrm -&gt; Service : KyHopDong(soHD, maNV, loaiHD, ngayKy, soQDCV, maCV, soQDL, luongCB, ...)\n\nService -&gt; Service : Kiểm tra đã hết thử việc, dữ liệu hợp lệ\n\nalt [hợp lệ]\n    Service -&gt; EntHD : themHopDong(soHD, maNV, loaiHD, ngayKY, ngayKT)\n    EntHD --&gt; Service : \n    \n    Service -&gt; EntQDCV : themQDCV(soQDCV, maNV, maCV, phuCapChucVu)\n    EntQDCV --&gt; Service : \n    \n    Service -&gt; EntQDL : themQDL(soQDL, maNV, luongCB, phuCapLuong, phuCapDocHai)\n    EntQDL --&gt; Service : \n\n    opt [loaiHD == Dài hạn]\n        Service -&gt; EntHSBH : themHoSoBH(soSHD, \&quot;BHYT\&quot;, mucDong)\n        EntHSBH --&gt; Service : \n        Service -&gt; EntHSBH : themHoSoBH(soSHD, \&quot;BHXH\&quot;, mucDong)\n        EntHSBH --&gt; Service : \n    end\n\n    Service --&gt; Frm : KetQuaXuLy.Ok (commit)\nelse [chưa hết thử việc hoặc thiếu thông tin]\n    Service --&gt; Frm : KetQuaXuLy.Fail (rollback)\nend\n\nFrm --&gt; NV : Thông báo kết quả ký hợp đồng\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="EzRNL6KI-fqMMfQgICtc-3163">
