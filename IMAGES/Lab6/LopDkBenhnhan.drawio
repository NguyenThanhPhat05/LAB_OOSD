        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\nskinparam linetype ortho\nskinparam BackgroundColor white\nhide circle\n\ntitle THIẾT KẾ LỚP CHO CHỨC NĂNG ĐĂNG KÝ BỆNH NHÂN - CẤP HỒ SƠ BỆNH ÁN\n\nclass FrmDangKy &lt;&lt; (B, #FF6600) giao diện &gt;&gt; {\n  + Frm_Load()\n  + Tai()\n  + btnTimBN_Click()\n  + btnThemBN_Click()\n  + btnLapPhieu_Click()\n  + btnThuLePhi_Click()\n  + btnCapHoSo_Click()\n  + btnDong_Click()\n}\n\nclass DangKyService &lt;&lt; (C, #00CC66) điều khiển &gt;&gt; {\n  + layBenhNhan()\n  + layPhieuDangKy()\n  + layNhanVien()\n  + themBenhNhan()\n  + lapPhieuDangKy()\n  + thuLePhi()\n  + capHoSo()\n}\n\nclass NhanVien {\n  + maNV : String (ID)\n  + hoTen : String\n  + boPhan : String\n  --\n  + themNhanVien()\n  + layDanhSach()\n}\n\nclass BenhNhan {\n  + maBN : String (ID)\n  + hoTen : String\n  + diaChi : String\n  + ngaySinh : Date\n  + dienThoai : String\n  + anh3x4 : Image\n  --\n  + themBenhNhan()\n  + capNhat()\n  + timKiem()\n}\n\nclass PhieuDangKy {\n  + soPhieuDK : String (ID)\n  + ngayDangKy : Date\n  --\n  + lapPhieu()\n  + layDanhSach()\n}\n\nclass LePhi {\n  + maPhi : String (ID)\n  + namApDung : integer\n  + soTien : Decimal\n  + ngayDong : Date\n  --\n  + thuLePhi()\n  + kiemTraConHan()\n}\n\nclass HoSoBenhAn {\n  + maHoSo : String (ID)\n  + ngayCap : Date\n  + trangThai : String\n  --\n  + capHoSo()\n  + traCuuHoSo()\n  + layLichSuKham()\n}\n\n&#39; Liên kết điều hướng từ Giao diện -&gt; Service -&gt; Các Thực thể (Entities)\nFrmDangKy --&gt; DangKyService\n\nDangKyService --&gt; NhanVien\nDangKyService --&gt; BenhNhan\nDangKyService --&gt; PhieuDangKy\nDangKyService --&gt; LePhi\nDangKyService --&gt; HoSoBenhAn\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="EzRNL6KI-fqMMfQgICtc-1215">
