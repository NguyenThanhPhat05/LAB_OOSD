        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam linetype ortho\nskinparam BackgroundColor white\nskinparam entity {\n  BackgroundColor LightYellow\n  BorderColor DarkRed\n  HeaderBackgroundColor #EEDC82\n}\n\ntitle Hình: ERD triển khai SQL Server - Hệ thống quản lý hồ sơ bệnh án\n\nentity \&quot;LePhi\&quot; as LePhi {\n  * **MaLePhi** : varchar(30) &lt;&lt;PK&gt;&gt;\n  --\n  * **MaHoSo** : varchar(30) &lt;&lt;FK&gt;&gt;\n  NamApDung : int\n  SoTien : decimal(18,2)\n  NgayDong : date\n}\n\nentity \&quot;PhieuDangKy\&quot; as PhieuDangKy {\n  * **SoPhieuDK** : varchar(30) &lt;&lt;PK&gt;&gt;\n  --\n  * **MaBN** : varchar(20) &lt;&lt;FK&gt;&gt;\n  * **MaNV** : varchar(20) &lt;&lt;FK&gt;&gt;\n  NgayDangKy : date\n}\n\nentity \&quot;BenhNhan\&quot; as BenhNhan {\n  * **MaBN** : varchar(20) &lt;&lt;PK&gt;&gt;\n  --\n  HoTen : nvarchar(120)\n  DiaChi : nvarchar(250)\n  NgaySinh : date\n  DienThoai : varchar(20)\n  Anh3x4 : varbinary(max)\n}\n\nentity \&quot;NhanVien\&quot; as NhanVien {\n  * **MaNV** : varchar(20) &lt;&lt;PK&gt;&gt;\n  --\n  HoTen : nvarchar(120)\n  BoPhan : nvarchar(50)\n}\n\nentity \&quot;HoSoBenhAn\&quot; as HoSoBenhAn {\n  * **MaHoSo** : varchar(30) &lt;&lt;PK&gt;&gt;\n  --\n  * **MaBN** : varchar(20) &lt;&lt;FK&gt;&gt;\n  NgayCap : date\n  TrangThai : nvarchar(30)\n}\n\nentity \&quot;LichHen\&quot; as LichHen {\n  * **MaLichHen** : varchar(30) &lt;&lt;PK&gt;&gt;\n  --\n  * **MaHoSo** : varchar(30) &lt;&lt;FK&gt;&gt;\n  NgayGioHen : datetime\n  Quy : int\n  TrangThai : nvarchar(30)\n}\n\nentity \&quot;PhieuKham\&quot; as PhieuKham {\n  * **SoPhieuKham** : varchar(30) &lt;&lt;PK&gt;&gt;\n  --\n  * **MaHoSo** : varchar(30) &lt;&lt;FK&gt;&gt;\n  * **MaBS** : varchar(20) &lt;&lt;FK&gt;&gt;\n  * **MaKhoa** : varchar(20) &lt;&lt;FK&gt;&gt;\n  * **MaNV** : varchar(20) &lt;&lt;FK&gt;&gt;\n  * **MaLichHen** : varchar(30) &lt;&lt;FK&gt;&gt;\n  NgayGioKham : datetime\n  LoaiKham : nvarchar(30)\n  TrieuChung : nvarchar(500)\n  ThanNhiet : decimal(4,1)\n  HuyetAp : varchar(20)\n  KetLuan : nvarchar(500)\n}\n\nentity \&quot;Khoa\&quot; as Khoa {\n  * **MaKhoa** : varchar(20) &lt;&lt;PK&gt;&gt;\n  --\n  TenKhoa : nvarchar(100)\n}\n\nentity \&quot;BacSi\&quot; as BacSi {\n  * **MaBS** : varchar(20) &lt;&lt;PK&gt;&gt;\n  --\n  * **MaKhoa** : varchar(20) &lt;&lt;FK&gt;&gt;\n  HoTen : nvarchar(120)\n  ChuyenMon : nvarchar(100)\n}\n\nentity \&quot;LoaiXetNghiem\&quot; as LoaiXetNghiem {\n  * **MaLoaiXN** : varchar(20) &lt;&lt;PK&gt;&gt;\n  --\n  TenXN : nvarchar(120)\n  MoTa : nvarchar(250)\n}\n\nentity \&quot;XetNghiem\&quot; as XetNghiem {\n  * **MaXN** : varchar(30) &lt;&lt;PK&gt;&gt;\n  --\n  * **SoPhieuKham** : varchar(30) &lt;&lt;FK&gt;&gt;\n  * **MaLoaiXN** : varchar(20) &lt;&lt;FK&gt;&gt;\n  NgayChiDinh : datetime\n  KetQua : nvarchar(500)\n  NgayCoKetQua : datetime\n}\n\nentity \&quot;ToaThuoc\&quot; as ToaThuoc {\n  * **MaToa** : varchar(30) &lt;&lt;PK&gt;&gt;\n  --\n  * **SoPhieuKham** : varchar(30) &lt;&lt;FK&gt;&gt;\n  NgayKeToa : date\n  LoiDan : nvarchar(500)\n}\n\nentity \&quot;ChiTietToaThuoc\&quot; as ChiTietToaThuoc {\n  * **MaToa** : varchar(30) &lt;&lt;PK, FK&gt;&gt;\n  * **MaThuoc** : varchar(20) &lt;&lt;PK, FK&gt;&gt;\n  --\n  SoLuong : int\n  LieuDung : nvarchar(100)\n  CachDung : nvarchar(200)\n}\n\nentity \&quot;Thuoc\&quot; as Thuoc {\n  * **MaThuoc** : varchar(20) &lt;&lt;PK&gt;&gt;\n  --\n  TenThuoc : nvarchar(120)\n  DonViTinh : nvarchar(40)\n  TacDungPhu : nvarchar(250)\n}\n\nentity \&quot;ThanhToanVienPhi\&quot; as ThanhToanVienPhi {\n  * **SoBienLai** : varchar(30) &lt;&lt;PK&gt;&gt;\n  --\n  * **SoPhieuKham** : varchar(30) &lt;&lt;FK&gt;&gt;\n  NgayThanhToan : datetime\n  SoTien : decimal(18,2)\n  HinhThuc : nvarchar(30)\n}\n\n&#39; Thiết lập quan hệ Crow&#39;s Foot theo sơ đồ gốc\nHoSoBenhAn ||--|{ LePhi\nBenhNhan ||--|{ PhieuDangKy\nNhanVien ||--|{ PhieuDangKy\nBenhNhan ||--|| HoSoBenhAn\nHoSoBenhAn ||--o{ LichHen\nHoSoBenhAn ||--o{ PhieuKham\n\nNhanVien ||--o{ PhieuKham\nKhoa ||--o{ PhieuKham\nKhoa ||--|{ BacSi\nBacSi ||--o{ PhieuKham\nLichHen |o--o{ PhieuKham\n\nLoaiXetNghiem ||--o{ XetNghiem\nPhieuKham ||--o{ XetNghiem\n\nPhieuKham ||--o| ToaThuoc\nToaThuoc ||--|{ ChiTietToaThuoc\nThuoc ||--o{ ChiTietToaThuoc\n\nPhieuKham ||--o{ ThanhToanVienPhi\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="EzRNL6KI-fqMMfQgICtc-1518">
