        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\nskinparam linetype ortho\nskinparam BackgroundColor white\nhide circle\n\ntitle BIỂU ĐỒ LỚP CHI TIẾT - HỆ THỐNG QUẢN LÝ HỒ SƠ BỆNH ÁN\n\nclass LePhi {\n  + maPhi : String (ID)\n  + namApDung : Integer\n  + soTien : Decimal\n  + ngayDong : Date\n  --\n  + thuLePhi()\n  + kiemTraConHan()\n}\n\nclass PhieuDangKy {\n  + soPhieuDK : String (ID)\n  + ngayDangKy : Date\n  --\n  + lapPhieu()\n  + layDanhSach()\n}\n\nclass BenhNhan {\n  + maBN : String (ID)\n  + hoTen : String\n  + diaChi : String\n  + ngaySinh : Date\n  + dienThoai : String\n  + anh3x4 : Image\n  --\n  + themBenhNhan()\n  + capNhat()\n  + timKiem()\n}\n\nclass HoSoBenhAn {\n  + maHoSo : String (ID)\n  + ngayCap : Date\n  + trangThai : String\n  --\n  + capHoSo()\n  + traCuuHoSo()\n  + layLichSuKham()\n}\n\nclass LichHen {\n  + maLichHen : String (ID)\n  + ngayGioHen : DateTime\n  + quy : Integer\n  + trangThai : String\n  --\n  + datLich()\n  + huyLich()\n}\n\nclass NhanVien {\n  + maNV : String (ID)\n  + hoTen : String\n  + boPhan : String\n  --\n  + themNhanVien()\n  + layDanhSach()\n}\n\nclass PhieuKham {\n  + soPhieuKham : String (ID)\n  + ngayGioKham : DateTime\n  + loaiKham : String\n  + trieuChung : String\n  + thanNhiet : float\n  + huyetAp : String\n  + ketLuan : String\n  --\n  + lapPhieuKham()\n  + ghiTrieuChung()\n  + layLichSu()\n  + capNhatToa()\n}\n\nclass Khoa {\n  + maKhoa : String (ID)\n  + tenKhoa : String\n  --\n  + themKhoa()\n  + layDanhSach()\n}\n\nclass BacSi {\n  + maBS : String (ID)\n  + hoTen : String\n  + chuyenMon : String\n  --\n  + themBacSi()\n  + layDanhSach()\n}\n\nclass ThanhToanVienPhi {\n  + soThanhToan : String (ID)\n  + ngayThanhToan : DateTime\n  + soTien : Decimal\n  + hinhThuc : String\n  --\n  + thanhToan()\n}\n\nclass LoaiXetNghiem {\n  + maLoaiXN : String (ID)\n  + tenXN : String\n  + moTa : String\n  --\n  + themLoaiXN()\n  + layDanhSach()\n}\n\nclass XetNghiem {\n  + maXN : String (ID)\n  + ngayChiDinh : DateTime\n  + ketQua : String\n  + ngayKetQua : DateTime\n  --\n  + chiDinh()\n  + ghiKetQua()\n}\n\nclass ToaThuoc {\n  + maToa : String (ID)\n  + ngayKeToa : Date\n  + loiDan : String\n  --\n  + keToa()\n  + layChiTiet()\n}\n\nclass ChiTietToaThuoc {\n  + soLuong : Integer\n  + lieuDung : String\n  + cachDung : String\n  --\n  + themChiTiet()\n}\n\nclass Thuoc {\n  + maThuoc : String (ID)\n  + tenThuoc : String\n  + donViTinh : String\n  + tacDungPhu : String\n  --\n  + themThuoc()\n  + xemThuoc()\n  + layDanhSach()\n}\n\n&#39; Liên kết quan hệ\nLePhi \&quot;1..*\&quot; -- \&quot;1\&quot; HoSoBenhAn\nPhieuDangKy \&quot;1..*\&quot; -- \&quot;1\&quot; BenhNhan : đăng ký &gt;\nPhieuDangKy \&quot;0..*\&quot; -- \&quot;1\&quot; NhanVien : lập &gt;\nBenhNhan \&quot;1\&quot; -- \&quot;1\&quot; HoSoBenhAn : sở hữu &gt;\nHoSoBenhAn \&quot;1\&quot; -- \&quot;0..*\&quot; LichHen : có &gt;\nHoSoBenhAn \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuKham : ghi nhận &gt;\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuKham : ghi vào máy &gt;\nPhieuKham \&quot;0..*\&quot; -- \&quot;1\&quot; Khoa : điều trị &gt;\nPhieuKham \&quot;0..*\&quot; -- \&quot;1\&quot; BacSi : khám &gt;\nPhieuKham \&quot;1\&quot; -- \&quot;0..1\&quot; ThanhToanVienPhi : thanh toán &gt;\nPhieuKham \&quot;1\&quot; -- \&quot;0..*\&quot; XetNghiem : chỉ định &gt;\nPhieuKham \&quot;1\&quot; -- \&quot;0..1\&quot; ToaThuoc : có &gt;\nKhoa \&quot;1\&quot; -- \&quot;1..*\&quot; BacSi : gồm &gt;\nLoaiXetNghiem \&quot;1\&quot; -- \&quot;0..*\&quot; XetNghiem : thuộc loại &gt;\nToaThuoc \&quot;1\&quot; -- \&quot;1..*\&quot; ChiTietToaThuoc : gồm &gt;\nChiTietToaThuoc \&quot;0..*\&quot; -- \&quot;1\&quot; Thuoc : được kê &gt;\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="EzRNL6KI-fqMMfQgICtc-959">
