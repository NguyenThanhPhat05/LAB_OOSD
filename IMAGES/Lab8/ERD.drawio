        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam linetype ortho\nskinparam BackgroundColor #FFFFFF\nskinparam EntityBackgroundColor #FFFFCC\nskinparam EntityBorderColor #990033\nskinparam EntityFontColor #000000\nskinparam ArrowColor #990033\nskinparam FontColor #000000\n\nentity \&quot;NhaCungUng\&quot; as NCU {\n  * MaNCU : String &lt;&lt;PK&gt;&gt;\n  --\n  TenNCU : String\n  DiaChi : String\n  SoDienThoai : String\n}\n\nentity \&quot;LoaiNGK\&quot; as Loai {\n  * MaLoai : String &lt;&lt;PK&gt;&gt;\n  --\n  TenLoai : String\n}\n\nentity \&quot;NuocGiaiKhat\&quot; as NGK {\n  * MaNGK : String &lt;&lt;PK&gt;&gt;\n  --\n  MaLoai : String &lt;&lt;FK&gt;&gt;\n  TenNGK : String\n  DonViTinh : String\n  DonGia : Float\n  SoLuongTon : Int\n}\n\nentity \&quot;DonDatHang\&quot; as DDH {\n  * SoDDH : String &lt;&lt;PK&gt;&gt;\n  --\n  MaNCU : String &lt;&lt;FK&gt;&gt;\n  NgayDat : Date\n  NgayNhanDuKien : Date\n}\n\nentity \&quot;ChiTietDDH\&quot; as CTDDH {\n  * SoDDH : String &lt;&lt;PK, FK&gt;&gt;\n  * MaNGK : String &lt;&lt;PK, FK&gt;&gt;\n  --\n  SoLuongDat : Int\n}\n\nentity \&quot;PhieuGiaoHang\&quot; as PGH {\n  * SoPGH : String &lt;&lt;PK&gt;&gt;\n  --\n  SoDDH : String &lt;&lt;FK&gt;&gt;\n  DotGiao : Int\n  NgayGiao : Date\n  SoTienPhaiTra : Float\n}\n\nentity \&quot;ChiTietPGH\&quot; as CTPGH {\n  * SoPGH : String &lt;&lt;PK, FK&gt;&gt;\n  * MaNGK : String &lt;&lt;PK, FK&gt;&gt;\n  --\n  SoLuongGiao : Int\n}\n\nentity \&quot;NhanVien\&quot; as NV {\n  * MaNV : String &lt;&lt;PK&gt;&gt;\n  --\n  HoTen : String\n  VaiTro : String\n}\n\nentity \&quot;KhachHang\&quot; as KH {\n  * MaKhach : String &lt;&lt;PK&gt;&gt;\n  --\n  HoTen : String\n  LoaiKhach : String\n  SoDienThoai : String\n}\n\nentity \&quot;HoaDon\&quot; as HD {\n  * SoHD : String &lt;&lt;PK&gt;&gt;\n  --\n  MaKhach : String &lt;&lt;FK&gt;&gt;\n  MaNV : String &lt;&lt;FK&gt;&gt;\n  NgayLap : Date\n  TongTien : Float\n  TrangThai : String\n}\n\nentity \&quot