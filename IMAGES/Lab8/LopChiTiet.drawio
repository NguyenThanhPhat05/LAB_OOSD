        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\nleft to right direction\n\n&#39; Cấu hình màu sắc &amp; đường nét chuẩn theo hình mẫu\nskinparam BackgroundColor #FFFFFF\nskinparam ClassBackgroundColor #FFFFCC\nskinparam ClassBorderColor #990033\nskinparam ClassFontColor #000000\nskinparam ArrowColor #990033\n\nclass NhaCungUng {\n  + MaNCU : String\n  + TenNCU : String\n  + DiaChi : String\n  + SoDienThoai : String\n  --\n  + themNCU() : void\n  + capNhatNCU() : void\n  + layDanhSachNCU() : List\n}\n\nclass LoaiNGK {\n  + MaLoai : String\n  + TenLoai : String\n  --\n  + themLoai() : void\n  + layDanhSachLoai() : List\n}\n\nclass NuocGiaiKhat {\n  + MaNGK : String\n  + TenNGK : String\n  + DonViTinh : String\n  + DonGia : Float\n  + SoLuongTon : Int\n  --\n  + KiemTraTon(sl: Int) : Boolean\n  + CapNhatTon(sl: Int) : void\n  + layDanhSachNGK() : List\n}\n\nclass DonDatHang {\n  + SoDDH : String\n  + NgayDat : Date\n  + NgayNhanDuKien : Date\n  --\n  + taoDonDatHang() : void\n  + huyDonDatHang() : void\n  + layThongTinDDH() : DonDatHang\n}\n\nclass ChiTietDDH {\n  + SoLuongDat : Int\n  --\n  + themChiTietDDH() : void\n  + tinhTongSoLuong() : Int\n}\n\nclass PhieuGiaoHang {\n  + SoPGH : String\n  + DotGiao : Int\n  + NgayGiao : Date\n  + SoTienPhaiTra : Float\n  --\n  + kiemTraDotGiao() : Boolean\n  + taoPhieuGiao() : void\n  + capNhatDotGiao() : void\n}\n\nclass ChiTietPGH {\n  + SoLuongGiao : Int\n  --\n  + themChiTietPGH() : void\n  + kiemTraSoLuongGiao() : Boolean\n}\n\nclass KhachHang {\n  + MaKhach : String\n  + HoTen : String\n  + LoaiKhach : String\n  + SoDienThoai : String\n  --\n  + themKhachHang() : void\n  + kiemTraKhachQuen() : Boolean\n  + layDanhSachKH() : List\n}\n\nclass NhanVien {\n  + MaNV : String\n  + HoTen : String\n  + VaiTro : String\n  --\n  + dangNhap() : Boolean\n  + layThongTinNV() : NhanVien\n}\n\nclass HoaDon {\n  + SoHD : String\n  + NgayLap : Date\n  + TongTien : Float\n  + TrangThai : String\n  --\n  + TinhTongTien() : Float\n  + CapNhatTrangThai(st: String) : void\n  + inHoaDon() : void\n}\n\nclass ChiTietHoaDon {\n  + SoLuong : Int\n  + DonGia : Float\n  + ThanhTien : Float\n  --\n  + tinhThanhTien() : Float\n  + themChiTietHD() : void\n}\n\nclass PhieuGhiNo {\n  + SoPhieuNo : String\n  + NgayLap : Date\n  + SoTienNo : Float\n  + NgayDuKienTra : Date\n  + LyDo : String\n  --\n  + taoPhieuNo() : void\n  + thanhToanNo() : void\n  + capNhatSoTienNo() : void\n}\n\n&#39; Mối quan hệ giữa các lớp\nLoaiNGK \&quot;1\&quot; -- \&quot;*\&quot; NuocGiaiKhat : thuộc &gt;\nNhaCungUng \&quot;1\&quot; -- \&quot;*\&quot; NuocGiaiKhat : cung cấp &gt;\nNhaCungUng \&quot;1\&quot; -- \&quot;*\&quot; DonDatHang : lập &gt;\nDonDatHang \&quot;1\&quot; -- \&quot;*\&quot; ChiTietDDH : có &gt;\nNuocGiaiKhat \&quot;1\&quot; -- \&quot;*\&quot; ChiTietDDH : thuộc về &gt;\nDonDatHang \&quot;1\&quot; -- \&quot;*\&quot; PhieuGiaoHang : gồm &gt;\nPhieuGiaoHang \&quot;1\&quot; -- \&quot;*\&quot; ChiTietPGH : có &gt;\nNuocGiaiKhat \&quot;1\&quot; -- \&quot;*\&quot; ChiTietPGH : giao trong &gt;\nKhachHang \&quot;1\&quot; -- \&quot;*\&quot; HoaDon : mua &gt;\nNhanVien \&quot;1\&quot; -- \&quot;*\&quot; HoaDon : lập &gt;\nHoaDon \&quot;1\&quot; -- \&quot;*\&quot; ChiTietHoaDon : có &gt;\nNuocGiaiKhat \&quot;1\&quot; -- \&quot;*\&quot; ChiTietHoaDon : thuộc về &gt;\nHoaDon \&quot;1\&quot; -- \&quot;0..1\&quot; PhieuGhiNo : tạo ra &gt;\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="EzRNL6KI-fqMMfQgICtc-4660">
